ZENDESK_SUBDOMAIN=feathr
# ZENDESK_EMAIL must be your @feathr.co address (NOT @feathrapp.com) — Zendesk accounts live under feathr.co
ZENDESK_EMAIL=your.name@feathr.co
ZENDESK_API_KEY=your_api_token_here
# ZENDESK_EMAIL and ZENDESK_API_KEY are stdio only; HTTP mode forwards each caller's OAuth token instead.
ACCESS_LEVEL=readonly
# Transport: stdio (default) or streamable-http. HTTP mode needs MCP_PUBLIC_URL when MCP_HOST is not loopback.
# Claude Code's stdio registration reads this file too, so MCP_TRANSPORT=streamable-http here switches it to HTTP.
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# Public base URL, https://host[:port], no path or trailing slash. Required when MCP_HOST is not loopback; unset for local runs (OAuth URLs then use http://MCP_HOST:MCP_PORT).
# MCP_PUBLIC_URL=https://zendesk-mcp.example.com
# ZENDESK_OAUTH_CLIENT_ID=44928675177239  # HTTP mode only: numeric ID of the zendesk_mcp OAuth client
# HTTP mode only: time budget in seconds (1-29, default 25) for each call on /zendesk/mcp. Under about 6 s, every write on /zendesk/mcp is refused.
# MCP_ZENDESK_FLOW_BUDGET_SECONDS=25
